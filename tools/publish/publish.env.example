# Template for .secrets/publish.env (the real file is git-ignored; never commit it or paste it into a chat).
# Fill in the blanks while following docs/PUBLISHING.md → One-time setup.
# Deliberately NOT .env/.env.local: Remotion loads those into the Studio/render bundle.
# Tokens don't go here either: `npm run publish:auth -- youtube|meta` saves them next to this file.

# ── YouTube ───────────────────────────────────────────────────────────────
# The OAuth client JSON you download from Google Cloud (type "Desktop app"). Save it at this path.
YOUTUBE_CLIENT_SECRET_FILE=.secrets/youtube-client.json
# Your channel id (starts with UC…). `npm run publish:auth -- youtube` prints it.
# Uploads refuse to run if the saved token belongs to a different channel.
YOUTUBE_CHANNEL_ID=

# ── Meta (Facebook Page + Instagram) ─────────────────────────────────────
# developers.facebook.com → your app → App settings → Basic
META_APP_ID=
META_APP_SECRET=
# Only needed if your Facebook account manages more than one Page
# (`npm run publish:auth -- meta` lists them if it can't pick one).
META_PAGE_ID=
# Graph API version for every Meta call.
META_GRAPH_VERSION=v26.0
# Optional, leave empty: have Instagram fetch the video from YOUR OWN public HTTPS folder instead of
# uploading the local file directly (default, no hosting needed).
IG_VIDEO_BASE_URL=
